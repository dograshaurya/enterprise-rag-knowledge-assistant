# Frontend dependencies and build output
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/.vercel/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
'@ | Set-Content -Encoding utf8 .gitignore