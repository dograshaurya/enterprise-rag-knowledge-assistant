@'
# Environment secrets
/.env
/.env.*
!/.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data and logs
*.sqlite3
uploads/
temp/
tmp/
